{
  "name": "fahy-cli",
  "version": "0.6.2",
  "description": "Anime, TV, movies, YouTube and music terminal player - search, pick, and watch in mpv",
  "type": "module",
  "bin": {
    "fahy": "./src/index.js"
  },
  "files": [
    "src/",
    "scripts/",
    "install.ps1",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "check": "node scripts/check.js",
    "audit": "node scripts/audit.js",
    "smoke": "node scripts/smoke.js",
    "smoke:offline": "node scripts/smoke.js --offline",
    "smoke:strict": "node scripts/smoke.js --offline --unhandled-rejections=strict"
  },
  "keywords": [
    "anime",
    "youtube",
    "music",
    "cli",
    "tui",
    "mpv",
    "yt-dlp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/emmanagellon/fahy-cli.git"
  },
  "bugs": {
    "url": "https://github.com/emmanagellon/fahy-cli/issues"
  },
  "homepage": "https://github.com/emmanagellon/fahy-cli#readme",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
